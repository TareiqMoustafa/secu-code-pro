{
  "manifest_version": 3,
  "name": "SecuCode Pro — Threat Scanner",
  "version": "1.0.0",
  "description": "فحص فوري لأي صفحة من المتصفح عبر محرك SecuCode Pro متعدد المصادر",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SecuCode Pro"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "options_page": "options.html"
}
